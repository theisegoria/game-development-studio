      "family": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "game_dev.asset_family.v1"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,50}$"
          },
