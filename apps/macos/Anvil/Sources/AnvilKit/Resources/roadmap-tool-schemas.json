    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "quarantine",
          "export"
        ],
        "default": "quarantine"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execute_workspace_retention": {
    "type": "object",
    "properties": {
      "plan": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "game_dev.retention_plan.v1"
          },
          "root": {
            "type": "string"
          },
          "metadataRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string",
            "enum": [
              "quarantine",
              "export"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "classification": {
                  "type": "string",
                  "enum": [
                    "original",
                    "derived",
                    "capture",
                    "metadata",
                    "unknown"
                  ]
                },
                "protectedBy": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "path",
                "bytes",
                "sha256",
                "classification",
                "protectedBy"
              ],
              "additionalProperties": false
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalBytes": {
            "type": "number"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "schema",
          "root",
          "metadataRoots",
          "action",
          "files",
          "blockers",
          "totalBytes",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "plan"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "plan_workspace_purge": {
    "type": "object",
    "properties": {
      "receiptId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
