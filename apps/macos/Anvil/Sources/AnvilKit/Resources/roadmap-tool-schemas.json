                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/properties/family/properties/template/properties/id"
                    },
                    "operation": {
                      "type": "string",
                      "enum": [
                        "generate_asset_reference",
                        "create_3d_asset",
                        "texture_existing_asset",
                        "download_asset",
                        "get_asset_job",
                        "select_reference",
                        "normalize_mesh",
                        "validate_game_asset",
                        "build_asset_package",
                        "prepare_collision_box",
                        "decompose_collision_mesh",
                        "validate_platform_asset",
                        "prepare_texture_variant",
                        "compress_texture_variant"
                      ]
                    },
                    "dependsOn": {
                      "type": "array",
                      "items": {
                        "$ref": "#/properties/family/properties/template/properties/id"
                      },
                      "maxItems": 64,
