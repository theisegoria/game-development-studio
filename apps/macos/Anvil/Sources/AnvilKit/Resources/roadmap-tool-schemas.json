    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "purge_workspace_retention": {
    "type": "object",
    "properties": {
      "plan": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "game_dev.retention_purge_plan.v1"
          },
          "root": {
            "type": "string"
          },
          "receiptId": {
            "type": "string",
            "format": "uuid"
          },
          "receiptSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "journalSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "metadataRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "interruptedMissing": {
            "type": "array",
            "items": {
              "$ref": "#/properties/plan/properties/files/items"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalBytes": {
            "type": "integer",
            "minimum": 0
          },
          "irreversibleWarning": {
            "type": "string",
            "const": "IRREVERSIBLE: permanently deletes the listed quarantine files. They cannot be restored from this receipt after purge. Review/export any needed bytes before confirming. ALL other workspace and quarantine writers must be stopped; portable path checks do not isolate hostile concurrent writers."
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "schema",
          "root",
          "receiptId",
          "receiptSha256",
          "journalSha256",
          "metadataRoots",
          "files",
          "interruptedMissing",
          "blockers",
          "totalBytes",
          "irreversibleWarning",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "plan"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
