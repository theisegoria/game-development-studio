  "save_production_recipe": {
    "type": "object",
    "properties": {
      "recipe": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "game_dev.production_recipe.v1"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/properties/recipe/properties/id"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "generate_asset_reference",
                    "create_3d_asset",
                    "texture_existing_asset",
                    "download_asset",
                    "get_asset_job",
                    "select_reference",
                    "normalize_mesh",
                    "validate_game_asset",
                    "build_asset_package",
                    "prepare_collision_box",
                    "decompose_collision_mesh",
                    "validate_platform_asset",
                    "prepare_texture_variant",
                    "compress_texture_variant"
                  ]
                },
                "dependsOn": {
                  "type": "array",
                  "items": {
                    "$ref": "#/properties/recipe/properties/id"
                  },
                  "maxItems": 64,
                  "default": []
                },
                "arguments": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 128,
                  "default": []
                }
              },
              "required": [
                "id",
                "operation",
                "arguments"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 128
          },
          "family": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/properties/recipe/properties/id"
              },
              "member": {
                "$ref": "#/properties/recipe/properties/id"
              },
              "sample": {
                "type": "boolean"
              },
              "approvalDigest": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "member",
              "sample"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema",
          "id",
          "name",
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "recipe"
